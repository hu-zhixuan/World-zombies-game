{
  "name": "world-zombies-game",
  "version": "57.4.0",
  "private": true,
  "type": "module",
  "description": "十五波围城：最后据点 —— v57 重做版（TypeScript + Phaser + Preact，打包成单个 HTML）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "npm run build && node tools/e2e/slice_walk.cjs",
    "apk": "npm run build && node tools/copy_to_android.cjs && cd android && ./gradlew assembleRelease",
    "legacy:build": "node legacy/build.js",
    "legacy:test": "node legacy/test_suite.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "preact": "^11.2.0"
  }
}
